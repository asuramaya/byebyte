[Unit]
Description=byebyte sweep — unattended reclaim (armed categories only)
Documentation=https://github.com/asuramaya/byebyte
After=byebyted.service
Requires=byebyted.service

[Service]
Type=oneshot
# The CLI is a thin socket client; byebyted (already running, already root)
# does the actual privileged reclaim work. Runs as root only so the socket
# connects unconditionally (the peercred gate allows root or owner_uid) —
# sweep itself never touches disk directly, and every act it triggers is
# ledgered by the daemon regardless of who asked for it.
ExecStart=/usr/local/bin/byebyte sweep
# byebyte's own client-side socket timeout for sweep is 280s -- DIAGNOSTIC
# VALUE, not yet the final one. 120s already proved too short on a real
# GitHub-hosted runner's filesystem (confirmed: it waited the full 120s and
# still reported daemon-unreachable while byebyted stayed active throughout),
# so this run is measuring the real ceiling, with per-category timing added
# in sweep() itself, before picking a permanent number or a different fix
# entirely. Systemd's own default TimeoutStartSec (90s) would otherwise kill
# the process before the client's own timeout ever gets a chance to fire and
# report a clean error, so it's raised here to stay outside it too.
TimeoutStartSec=300
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=no
