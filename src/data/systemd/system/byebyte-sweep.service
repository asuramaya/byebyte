[Unit]
Description=byebyte sweep — unattended reclaim (armed categories only)
Documentation=https://github.com/asuramaya/byebyte
After=byebyted.service
Requires=byebyted.service

[Service]
Type=oneshot
# The CLI is a thin socket client; byebyted (already running, already root)
# does the actual privileged reclaim work. Runs as root only so the socket
# connects unconditionally (the peercred gate allows root or owner_uid) —
# sweep itself never touches disk directly, and every act it triggers is
# ledgered by the daemon regardless of who asked for it.
ExecStart=/usr/local/bin/byebyte sweep
# byebyte's own client-side socket timeout for sweep is 120s (a full,
# unarmed registry preview -- unbounded scan_roots walk plus two 10s-bounded
# subprocess calls -- found for real to exceed the old 30s default on a
# fully-populated filesystem). Systemd's own default TimeoutStartSec (90s)
# would kill the process before that timeout ever gets a chance to fire and
# report a clean error, so it's raised here to stay comfortably outside it.
TimeoutStartSec=180
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=no
