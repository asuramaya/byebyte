[Unit]
Description=byebyte sweep — unattended reclaim (armed categories only)
Documentation=https://github.com/asuramaya/byebyte
After=byebyted.service
Requires=byebyted.service

[Service]
Type=oneshot
# The CLI is a thin socket client; byebyted (already running, already root)
# does the actual privileged reclaim work. Runs as root only so the socket
# connects unconditionally (the peercred gate allows root or owner_uid) —
# sweep itself never touches disk directly, and every act it triggers is
# ledgered by the daemon regardless of who asked for it.
ExecStart=/usr/local/bin/byebyte sweep
# byebyte's own client-side socket timeout for sweep is 180s -- comfortable
# margin over the measured 169.83s worst case (an ARMED project-artifacts,
# on a GitHub-hosted runner's fully-populated filesystem; unarmed is fast,
# byebyted skips that walk unless armed). Systemd's own default
# TimeoutStartSec (90s) would otherwise kill the process before the
# client's own timeout ever gets a chance to fire and report a clean
# error, so it's raised here to stay outside it too.
TimeoutStartSec=240
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=no
