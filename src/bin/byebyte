#!/usr/bin/env python3
"""byebyte — verb CLI over the byebyted control socket.

Talks to the daemon's socket; `status` falls back to reading status.json
so it still answers even mid-daemon-restart. Every verb accepts --json.

  status                  headroom, burn rate, ETA-to-full, quota per mount
  why [path] [--limit N]  instant du-tree from the index, age-tagged
  blame [--since T]       what grew since T (1d/1w/2026-07-01), default 1d
  scan [--wait]           kick off an on-demand index refresh
  purge <category> [--yes]   delete what a category detector matches (dry-run by default)
  declare <path> [--yes]  delete exactly this one path (dry-run by default) — declared scope, not a category
  reserve <mountpoint> [percent] [--yes]   ext2/3/4's own privileged-writer headroom, floor 1%
  journal-cap <size> [--yes]   bound journald's own disk footprint (e.g. 500M, 1G)
  fstrim-schedule [on|off] [--yes]   the stock weekly TRIM timer, on or off
  tmp-size <size> [--yes] cap /tmp's tmpfs size (PENDING until reboot/remount)
  ghosts                  deleted-but-open files still holding disk blocks
  ballast [release]       show or release the pre-allocated emergency reserve
  kernels                 removable kernel packages, prints the apt line, never runs it
  advise                  one-line nudges: near-full mounts, fast growers, cold caches
  burn [--seconds N] [--limit N]   live per-process write rates
  sweep [--dry] [--history]   the unattended reclaim policy (double-consent)
  update [--check]        delegates to byebyte-update

With no verb, runs status. See byebyte(1) for full detail.
"""

import json
import os
import pwd
import shutil
import subprocess
import sys
import time

# --- sutra bootstrap (sutra 0.12.9; see docs/BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "byebyte"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra

RUNTIME_DIR = os.environ.get("BYEBYTE_RUNTIME_DIR", "/run/byebyte")

PLANNED = {}


def request(payload, timeout=30):
    """One JSON command to the daemon; None if the socket is unreachable."""
    sock_path = os.path.join(RUNTIME_DIR, "control.sock")
    return sutra.request(sock_path, payload, timeout=timeout)


def request_or_die(payload, timeout=30, as_json=False):
    """as_json=True (pass the caller's own "--json" in argv) makes a daemon
    refusal exit through stdout as parseable {"error": ...} JSON instead of
    sys.exit's plain-text stderr line -- found while wiring the pill's own
    subprocess+--json calls to declare/reserve: sys.exit always fired BEFORE
    a verb's own --json print ever ran, so every refusal (declare's
    denylist, reserve's fstype guard, anything) silently never reached
    stdout at all -- a caller parsing --json output saw empty stdout and
    could only tell "something failed", never why, indistinguishable from
    the daemon being unreachable."""
    doc = request(payload, timeout=timeout)
    if doc is None:
        if as_json:
            print(json.dumps({"error": "daemon unreachable"}))
            sys.exit(1)
        sys.exit("byebyte: daemon unreachable — is byebyted running?")
    if isinstance(doc, dict) and "error" in doc:
        if as_json:
            print(json.dumps(doc, indent=2))
            sys.exit(1)
        sys.exit(f"byebyte: {doc['error']}")
    return doc


def fetch():
    doc = request({"cmd": "status"})
    if isinstance(doc, dict) and "mounts" in doc:
        return doc
    doc = sutra.read_status(os.path.join(RUNTIME_DIR, "status.json"))
    if doc is None:
        sys.exit("byebyte: no daemon and no status.json — is byebyted running?")
    return doc


def human_bytes(n):
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n / 1.0:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}T"


def human_burn(bps):
    per_day = bps * 86400
    if abs(per_day) < 1024 * 1024:
        return "quiet"
    return f"{human_bytes(per_day)}/day"


def human_eta(seconds):
    if seconds is None:
        return "—"
    if seconds >= 14 * 86400:
        return f"~{seconds // (7 * 86400)}w"
    if seconds >= 2 * 86400:
        return f"~{seconds // 86400}d"
    if seconds >= 2 * 3600:
        return f"~{seconds // 3600}h"
    return f"~{max(1, seconds // 60)}m"


FLAGS = {"ok": " ", "warn": "!", "hot": "‼", "edquot": "✗"}


def cmd_status(argv):
    doc = fetch()
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    age = int(time.time() - doc["ts"])
    print(f"byebyte v{doc['daemon']['version']}   (status {age}s old)")
    for m in doc["mounts"]:
        flag = FLAGS.get(m["state"], "?")
        line = (f" {flag} {m['mountpoint']:<12} "
                f"{human_bytes(m['effective_free']):>8} free "
                f"of {human_bytes(m['total']):>8}   "
                f"burn {human_burn(m['burn_bps']):<12} "
                f"full {human_eta(m['eta_seconds'])}")
        if m.get("quota"):
            q = m["quota"]
            line += (f"   [quota: {human_bytes(q['remaining'])}"
                     f" of {human_bytes(q['limit'])} left]")
        print(line)


def _flag_val(argv, name, default):
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return default


def _age_tag(newest_mtime, now):
    if not newest_mtime:
        return "?"
    days = (now - newest_mtime) / 86400
    if days < 1:
        return "hot"
    if days < 30:
        return f"{int(days)}d"
    if days < 90:
        return f"{int(days / 30)}mo"
    return f"cold {int(days / 30)}mo"


def parse_since(text, now):
    """'2h', '3d', '1w' or 'YYYY-MM-DD' -> epoch seconds."""
    units = {"h": 3600, "d": 86400, "w": 7 * 86400}
    if text and text[-1] in units:
        try:
            return now - float(text[:-1]) * units[text[-1]]
        except ValueError:
            pass
    try:
        return time.mktime(time.strptime(text, "%Y-%m-%d"))
    except ValueError:
        sys.exit(f"byebyte: bad --since '{text}' (want 2h / 3d / 1w"
                 " or YYYY-MM-DD)")


def cmd_scan(argv):
    as_json = "--json" in argv
    doc = request_or_die({"cmd": "scan"}, as_json=as_json)
    if doc.get("running") and not doc.get("started"):
        print("scan already running")
    else:
        print("scan started")
    if "--wait" in argv:
        while True:
            time.sleep(1)
            st = request_or_die({"cmd": "status"}, as_json=as_json)
            idx = st.get("index") or {}
            if not idx.get("scanning"):
                age = int(time.time() - (idx.get("last_scan") or 0))
                print(f"scan done ({age}s ago)")
                return


def print_btrfs_notice(doc):
    b = doc.get("btrfs")
    if not b:
        return
    if not b.get("available"):
        print(f"  note: btrfs accounting unavailable on {b['mountpoint']}"
              f" ({b.get('reason', 'unknown reason')})")
    elif b.get("snapshots"):
        pinned = b.get("pinned_bytes")
        pin = f" pin {human_bytes(pinned)}" if pinned else " (pinned bytes unknown — quotas off)"
        print(f"  note: {b['snapshots']} snapshot(s) on {b['mountpoint']}{pin}"
              " the walk can't see")


def cmd_why(argv):
    path = next((a for a in argv if not a.startswith("-")
                 and a != _flag_val(argv, "--limit", None)), "/")
    limit = int(_flag_val(argv, "--limit", "15"))
    doc = request_or_die({"cmd": "why", "path": path, "limit": limit}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    now = time.time()
    age = human_eta(int(now - doc["scan_ts"])).lstrip("~")
    total = doc.get("total")
    head = f"{human_bytes(total)} in " if total is not None else ""
    print(f"{head}{doc['path']}   (scanned {age} ago)")
    for r in doc["rows"]:
        print(f"  {human_bytes(r['bytes']):>8}  {_age_tag(r['newest_mtime'], now):<10}"
              f"  {r['path']}")
    if not doc["rows"]:
        print("  (nothing above the index threshold here)")
    print_btrfs_notice(doc)


def cmd_blame(argv):
    now = time.time()
    since = parse_since(_flag_val(argv, "--since", "1d"), now)
    limit = int(_flag_val(argv, "--limit", "15"))
    doc = request_or_die({"cmd": "blame", "since": since, "limit": limit}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    span = human_eta(int(doc["head_ts"] - doc["base_ts"])).lstrip("~")
    print(f"grew over the last {span} (parents include their children):")
    for r in doc["rows"]:
        sign = "+" if r["delta"] >= 0 else ""
        print(f"  {sign}{human_bytes(r['delta']):>8}  {r['path']}"
              f"  (now {human_bytes(r['bytes'])})")
    if not doc["rows"]:
        print("  nothing moved above the index threshold")
    print_btrfs_notice(doc)


def cmd_purge(argv):
    positional = [a for a in argv if not a.startswith("-")]
    if not positional or positional[0] == "all" or "--all" in argv:
        sys.exit("byebyte purge: --all is refused — one category per act")
    category = positional[0]
    yes = "--yes" in argv
    doc = request_or_die({"cmd": "purge", "category": category, "dry_run": not yes}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    if doc.get("dry_run"):
        cands = doc.get("candidates", [])
        if not cands:
            print(f"{category}: nothing to purge")
            if doc.get("note"):
                print(f"  note: {doc['note']}")
            return
        for c in cands:
            print(f"  {human_bytes(c['bytes']):>8}  {c['path']}")
        print(f"{human_bytes(doc['total_bytes'])} would be freed"
              " (dry-run — add --yes to execute)")
    else:
        freed = doc.get("freed_bytes", 0)
        errors = [r for r in doc.get("results", []) if not r["ok"]]
        tail = f" ({len(errors)} failed)" if errors else ""
        print(f"{category}: freed {human_bytes(freed)}{tail}")
        if doc.get("note"):
            print(f"  note: {doc['note']}")


def cmd_declare(argv):
    """purge's category-free sibling: FAMILY.md's declared-scope doctrine —
    scanning stays broad, but what the daemon may eat is named by the human,
    one path at a time, from what a scan already surfaced. Never widens past
    a compiled-in denylist the daemon enforces itself (see byebyted.py's
    _declare_denied_reason) — dry-run by default is real protection, but
    --yes is one keystroke, so the invariant has to hold on the other side
    of it too."""
    positional = [a for a in argv if not a.startswith("-")]
    if not positional:
        sys.exit("byebyte declare: needs a path (from `why`/`blame`/`advise`)")
    path = positional[0]
    yes = "--yes" in argv
    doc = request_or_die({"cmd": "declare", "path": path, "dry_run": not yes}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    if doc.get("dry_run"):
        kind = "directory" if doc.get("is_dir") else "file"
        print(f"  {human_bytes(doc['bytes']):>8}  {doc['path']}  ({kind})")
        print(f"{human_bytes(doc['bytes'])} would be freed"
              " (dry-run — add --yes to execute)")
    elif doc.get("skipped"):
        print(f"declare: {doc['path']} changed since it was declared "
              "— skipped, nothing deleted")
    elif doc.get("ok"):
        print(f"declare: freed {human_bytes(doc['bytes'])} from {doc['path']}")
    else:
        print(f"declare: failed to delete {doc['path']}")


def cmd_reserve(argv):
    """reserved-blocks: ext2/3/4's own privileged-writer headroom (tune2fs
    -m). The floor never goes below 1% regardless of what's asked for --
    e2fsprogs accepts 0% silently, and refusing it here is the only guard
    against a full disk locking out even root. Applies immediately to a
    mounted filesystem, no reboot needed."""
    positional = [a for a in argv if not a.startswith("-")]
    if not positional:
        sys.exit("byebyte reserve: needs a mountpoint (see `byebyte status`)")
    mountpoint = positional[0]
    percent = None
    if len(positional) > 1:
        try:
            percent = float(positional[1])
            if percent == int(percent):
                percent = int(percent)
        except ValueError:
            sys.exit(f"byebyte reserve: '{positional[1]}' is not a number")
    yes = "--yes" in argv
    doc = request_or_die({"cmd": "reserve", "mountpoint": mountpoint,
                          "percent": percent, "dry_run": not yes}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    if doc.get("dry_run"):
        print(f"{mountpoint}: {doc['current_percent']}% reserved "
              f"(device {doc['device']})")
        if doc.get("proposed_percent") is not None:
            delta = doc.get("proposed_avail_delta_bytes")
            sign = "+" if (delta or 0) >= 0 else ""
            shown = f"{sign}{human_bytes(delta)}" if delta is not None else "?"
            print(f"  -> {doc['proposed_percent']}% would change free space by "
                  f"{shown} (dry-run — add --yes to apply)")
    elif doc.get("ok"):
        sign = "+" if doc["avail_delta_bytes"] >= 0 else ""
        print(f"reserve: {mountpoint} {doc['prior_percent']}% -> {doc['new_percent']}% "
              f"({sign}{human_bytes(doc['avail_delta_bytes'])} free)")
    else:
        print(f"reserve: {mountpoint} set to {doc['new_percent']}% but free space "
              "didn't move — treat as failed")


def cmd_journal_cap(argv):
    """journal-cap: bound journald's own persistent disk footprint via a
    journald.conf.d drop-in (SystemMaxUse=), applied live with `systemctl
    reload systemd-journald` -- no restart, logging never interrupts.
    --vacuum-size only shrinks archived journal files immediately; the
    currently-active segment can still push usage over the new cap until it
    rotates on its own, same not-quite-atomic shape as journald's own vacuum."""
    positional = [a for a in argv if not a.startswith("-")]
    if not positional:
        sys.exit("byebyte journal-cap: needs a size, e.g. 500M or 1G")
    size = positional[0]
    yes = "--yes" in argv
    doc = request_or_die({"cmd": "journal-cap", "size": size, "dry_run": not yes},
                         as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    if doc.get("dry_run"):
        print(f"journald: {doc['current_cap'] or 'uncapped'} cap, "
              f"{human_bytes(doc['usage_bytes'])} used")
        print(f"  -> cap to {doc['proposed_cap']} (dry-run — add --yes to apply)")
    elif doc.get("ok"):
        freed = doc.get("freed_bytes")
        tail = f", freed {human_bytes(freed)}" if freed else ""
        skip = doc.get("reload_skipped")
        note = f" ({skip})" if skip else ""
        print(f"journal-cap: {doc['prior_cap'] or 'uncapped'} -> {doc['new_cap']}{tail}{note}")
        if doc.get("note"):
            print(f"  note: {doc['note']}")
    else:
        print("journal-cap: failed")


def cmd_fstrim_schedule(argv):
    """fstrim-schedule: the stock weekly TRIM timer (fstrim.timer), on or
    off -- no custom config, just the shipped unit's own enablement.
    Applies immediately (systemctl enable/disable --now); never deferred,
    the very next is-enabled/next-run read proves it."""
    positional = [a for a in argv if not a.startswith("-")]
    enabled = None
    if positional:
        arg = positional[0].lower()
        if arg in ("on", "enable", "enabled"):
            enabled = True
        elif arg in ("off", "disable", "disabled"):
            enabled = False
        else:
            sys.exit(f"byebyte fstrim-schedule: '{positional[0]}' -- want on or off")
    yes = "--yes" in argv
    if yes and enabled is None:
        sys.exit("byebyte fstrim-schedule: needs on/off to apply --yes")
    doc = request_or_die({"cmd": "fstrim-schedule", "enabled": enabled,
                          "dry_run": not yes}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    if doc.get("dry_run"):
        state = "on" if doc["current_enabled"] else "off"
        tail = f", next run {doc['next_run']}" if doc.get("next_run") else ""
        print(f"fstrim schedule: {state}{tail}")
        proposed = doc.get("proposed_enabled")
        if proposed is not None and proposed != doc["current_enabled"]:
            want = "on" if proposed else "off"
            print(f"  -> turn {want} (dry-run — add --yes to apply)")
    elif doc.get("ok"):
        prior = "on" if doc["prior_enabled"] else "off"
        new = "on" if doc["new_enabled"] else "off"
        tail = f", next run {doc['next_run']}" if doc.get("next_run") else ""
        print(f"fstrim-schedule: {prior} -> {new}{tail}")
    else:
        print("fstrim-schedule: requested change did not take effect")


def cmd_tmp_size(argv):
    """tmp-size: cap /tmp's own tmpfs size via a tmp.mount drop-in. PENDING,
    not done: the write is instant but /tmp is never remounted by this verb
    -- the new cap only takes effect at the next reboot, or a manual
    `systemctl daemon-reload && systemctl restart tmp.mount`."""
    positional = [a for a in argv if not a.startswith("-")]
    if not positional:
        sys.exit("byebyte tmp-size: needs a size, e.g. 2G or 512M")
    size = positional[0]
    yes = "--yes" in argv
    doc = request_or_die({"cmd": "tmp-size", "size": size, "dry_run": not yes},
                         as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    if doc.get("dry_run"):
        live = f" ({human_bytes(doc['live_total_bytes'])} currently)" \
            if doc.get("live_total_bytes") else ""
        print(f"/tmp: {doc['current_cap'] or 'default'} cap{live}")
        print(f"  -> cap to {doc['proposed_cap']} (dry-run — add --yes to apply, "
              "PENDING until reboot or a manual remount)")
    elif doc.get("ok"):
        print(f"tmp-size: {doc['prior_cap'] or 'default'} -> {doc['new_cap']} "
              "(PENDING — takes effect at the next reboot or manual remount)")
        if doc.get("note"):
            print(f"  note: {doc['note']}")
    else:
        print("tmp-size: failed")


def cmd_ghosts(argv):
    doc = request_or_die({"cmd": "ghosts"}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    ghosts_list = doc.get("holders", [])
    if not ghosts_list:
        print("no ghosts — nothing deleted-but-open")
        return
    for g in ghosts_list:
        mounts = ",".join(g["mounts"]) if g["mounts"] else "?"
        who = ", ".join(f"pid {h['pid']} {h['comm']} ({h['fds']} fd(s))"
                        for h in g["holders"])
        print(f"  {human_bytes(g['bytes']):>8}  on {mounts}  held by {who}")
    print(f"{human_bytes(doc['total_bytes'])} held by deleted-but-open files")


def cmd_ballast(argv):
    action = "release" if (argv and argv[0] == "release") else "status"
    doc = request_or_die({"cmd": "ballast", "action": action}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    if action == "release":
        print(f"ballast released: {human_bytes(doc['freed_bytes'])} "
              f"({len(doc['released'])} slab(s))")
    else:
        slabs = doc.get("slabs", [])
        if not slabs:
            print("ballast: no slabs (off, or not built yet)")
            return
        for s in slabs:
            print(f"  {human_bytes(s['bytes']):>8}  {s['name']}")
        print(f"{human_bytes(doc['total_bytes'])} reserved")


def cmd_kernels(argv):
    doc = request_or_die({"cmd": "kernels"}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    print(f"running: {doc['running']}   newest: {doc['newest'] or '?'}")
    cands = doc.get("candidates", [])
    if not cands:
        print("no removal candidates")
        return
    for c in cands:
        pkg = c.get("package") or "(no dpkg package found)"
        print(f"  {c['version']:<24} {pkg}")
    if doc.get("apt_line"):
        print(doc["apt_line"])


def cmd_advise(argv):
    doc = request_or_die({"cmd": "advise"}, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    findings = doc.get("findings", [])
    if not findings:
        print("advise: nothing to flag")
        return
    for f in findings:
        rule = f["rule"]
        if rule == "eta_soon":
            print(f"  {f['mount']} fills in {human_eta(int(f['eta_seconds']))}"
                  f" (burn {human_burn(f['burn_bps'])})")
        elif rule == "quota_low":
            pct = 100 * f["remaining"] / f["limit"] if f["limit"] else 0
            print(f"  {f['mount']} quota headroom low: "
                  f"{human_bytes(f['remaining'])} of {human_bytes(f['limit'])}"
                  f" left ({pct:.0f}%) — EDQUOT risk")
        elif rule == "fast_grower":
            print(f"  {f['path']} growing {human_bytes(f['bytes_per_day'])}/day")
        elif rule == "cold_cache":
            print(f"  {f['category']} is {human_bytes(f['bytes'])} and untouched"
                  f" 90+ days — cold cache")
        elif rule == "ghosts_heavy":
            print(f"  {human_bytes(f['bytes'])} held by deleted-but-open files"
                  f" — see: byebyte ghosts")
        else:
            print(f"  {rule}: {f}")


def cmd_burn(argv):
    seconds = int(_flag_val(argv, "--seconds", "5"))
    limit = int(_flag_val(argv, "--limit", "15"))
    doc = request_or_die({"cmd": "burn", "seconds": seconds, "limit": limit},
                          timeout=seconds + 10, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    writers = doc.get("writers", [])
    if not writers:
        print(f"no writes ≥ 1B/s over {doc.get('seconds', seconds)}s")
        return
    for w in writers:
        mount = f"  (writing on {w['mount']})" if w.get("mount") else ""
        top_path = f"  -> {w['top_path']}" if w.get("top_path") else ""
        print(f"  {human_bytes(w['bytes_per_sec']):>8}/s   pid {w['pid']:<7} "
              f"{w['comm']:<16}{mount}{top_path}")


def notify_owner(uid, summary, body):
    """Best-effort notify-send into the owner's desktop session. Silently
    does nothing if there's no active login session (bus socket absent) or
    anything about reaching it fails — a sweep's success never depends on
    whether a toast could be shown."""
    if uid is None:
        return
    bus = f"/run/user/{uid}/bus"
    if not os.path.exists(bus):
        return
    try:
        name = pwd.getpwuid(uid).pw_name
    except KeyError:
        return
    try:
        subprocess.run(
            ["runuser", "-u", name, "--",
             "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
             "notify-send", "-a", "byebyte", "-u", "normal", summary, body],
            capture_output=True, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def cmd_sweep(argv):
    if "--history" in argv:
        limit = int(_flag_val(argv, "--limit", "15"))
        doc = request_or_die({"cmd": "sweep", "history": True, "limit": limit}, as_json="--json" in argv)
        if "--json" in argv:
            print(json.dumps(doc, indent=2))
            return
        lines = doc.get("history", [])
        if not lines:
            print("sweep: no history yet")
            return
        for l in lines:
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(l["ts"]))
            size = f" {human_bytes(l['bytes'])}" if l.get("bytes") else ""
            print(f"  {when}  {l['category']:<20} {l['status']:<8}{size}  {l['target']}")
        return

    force_dry = "--dry" in argv
    # An unarmed sweep is fast now (byebyted skips project-artifacts's live
    # scan_roots walk unless it's armed -- see _SWEEP_UNARMED_SKIP), but an
    # ARMED project-artifacts still pays that walk for real, and it's
    # measured at 169.83s on a GitHub-hosted runner's fully-populated
    # filesystem -- the 30s default gave "daemon unreachable" while byebyted
    # was still healthy and just not done computing. sweep is a
    # timer-triggered background job, never an interactive hot path, so
    # waiting comfortably past the measured worst case costs nothing real.
    doc = request_or_die({"cmd": "sweep", "dry": force_dry}, timeout=180, as_json="--json" in argv)
    if "--json" in argv:
        print(json.dumps(doc, indent=2))
        return
    results = doc.get("results", [])
    printed = False
    for r in results:
        cat = r["category"]
        if cat == "kernels":
            cands = r.get("candidates", [])
            if cands:
                print(f"  kernels: {len(cands)} removable (report-only, never auto-removed)")
                if r.get("apt_line"):
                    print(f"    {r['apt_line']}")
                printed = True
            continue
        if r["dry_run"]:
            total = r.get("total_bytes", 0)
            if not total:
                continue
            tag = "armed, --dry preview" if r["armed"] else "not armed"
            print(f"  [{tag}] {cat}: {human_bytes(total)} would be freed")
        else:
            item_results = r.get("results", [])
            if not item_results:
                continue  # armed, but nothing was there to reclaim this time
            freed = r.get("freed_bytes", 0)
            errors = [x for x in item_results if not x["ok"]]
            tail = f" ({len(errors)} failed)" if errors else ""
            print(f"  [armed] {cat}: freed {human_bytes(freed)}{tail}")
        printed = True
    if not printed:
        print("sweep: nothing to report")

    acted = [r for r in results if not r.get("dry_run") and r.get("freed_bytes", 0) > 0]
    if acted and not force_dry:
        status = request({"cmd": "status"})
        uid = (status or {}).get("daemon", {}).get("owner_uid")
        total_freed = sum(r["freed_bytes"] for r in acted)
        cats = ", ".join(r["category"] for r in acted)
        notify_owner(uid, f"swept {human_bytes(total_freed)}",
                     f"reclaimed from: {cats} — see: byebyte sweep --json")
        # notify_owner is deliberately best-effort and silent (a sweep's
        # success never depends on whether a toast could be shown), so
        # "no active login session" -- the common, nothing-to-remedy case
        # on a headless box -- and "the tool itself is missing" both fail
        # the same silent way from in there. Distinguish the one case with
        # an actual fix here instead, where it lands in this run's own
        # output -- stdout on an interactive run, journald when the sweep
        # timer unit invokes this exact command.
        if shutil.which("notify-send") is None:
            print("  note: desktop notifications unavailable "
                  "(apt install libnotify-bin)")


def cmd_update(argv):
    """Delegate straight to byebyte-update (execvp — its exit code becomes
    ours). `byebyte update --check --json` is the pill's UpdateSurface
    checking for a newer release without needing pkexec; a bare `byebyte
    update` is the manual-install consent tier."""
    binary = "byebyte-update"
    path = binary  # last resort: PATH lookup
    for cand in (f"/usr/bin/{binary}", f"/usr/local/bin/{binary}"):
        if os.path.exists(cand):
            path = cand
            break
    try:
        os.execvp(path, [binary, *argv])
    except OSError as e:
        sys.exit(f"cannot run {binary}: {e}")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    verb = argv[0] if argv and not argv[0].startswith("-") else "status"
    rest = argv[1:] if argv and not argv[0].startswith("-") else argv
    verbs = {"status": cmd_status, "scan": cmd_scan,
             "why": cmd_why, "blame": cmd_blame, "purge": cmd_purge,
             "declare": cmd_declare, "reserve": cmd_reserve,
             "journal-cap": cmd_journal_cap, "fstrim-schedule": cmd_fstrim_schedule,
             "tmp-size": cmd_tmp_size,
             "ghosts": cmd_ghosts, "ballast": cmd_ballast, "kernels": cmd_kernels,
             "advise": cmd_advise, "burn": cmd_burn, "sweep": cmd_sweep,
             "update": cmd_update}
    if verb in verbs:
        verbs[verb](rest)
    elif verb in PLANNED:
        sys.exit(f"byebyte {verb}: not yet — {PLANNED[verb]}")
    else:
        known = ", ".join(list(verbs) + list(PLANNED))
        sys.exit(f"byebyte: unknown verb '{verb}' (verbs: {known})")


if __name__ == "__main__":
    main()
