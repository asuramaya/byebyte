#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 asuramaya and byebyte contributors
"""byebyte-update — is a newer byebyte release out? Install it, on consent.

Thin wrapper over sutra_update (UNIFY Wave A #1, the family's update spine —
one grammar, one trust chain, one install-path detection, three consent
tiers). This is deliberately a SEPARATE program from the daemon: byebyted
never touches the network at all, so the one component that reaches the
internet is this small, unprivileged-when-checking updater — never the
privileged control loop (phanspeed's split, inherited verbatim).

  byebyte-update --check          human-readable: newer release or not
  byebyte-update --check --json   {"current","latest","available","armed"}
  byebyte-update                  manual install (explicit human consent)

auto_enabled is hardcoded False: byebyte-update.timer runs --check only
(family doctrine: updates are click-to-install). The release-signing
anchor ships EMPTY from birth (arm-first, docs/RELEASE-SIGNING.md) — an
--auto tier would no-op against an unarmed anchor regardless, but there's
no config knob pretending otherwise until arming is a decision someone's
actually made.
"""

import os
import sys

# --- sutra bootstrap (sutra 0.11.0; see docs/BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "byebyte"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra_update

_SRC_DIR = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
# three dirnames: byebyte-update -> src/bin -> src -> the repo root, since
# this file lives at src/bin/byebyte-update now (REPO-STANDARD.md tree
# pass) rather than bin/byebyte-update.
# .deb installs share/ under /usr; install.sh's source install defaults
# PREFIX to /usr/local — both are real, so both are checked before falling
# back to the repo-relative path for a dev checkout that's never been
# installed at all.
VERSION_CANDIDATES = ("/usr/share/byebyte/VERSION",
                      "/usr/local/share/byebyte/VERSION",
                      os.path.join(_SRC_DIR, "packaging", "VERSION"))
ANCHOR_CANDIDATES = ["/usr/share/byebyte/allowed_signers",
                     "/usr/local/share/byebyte/allowed_signers",
                     os.path.join(_SRC_DIR, "packaging", "release-signing", "allowed_signers")]


def installed_version():
    for path in VERSION_CANDIDATES:
        try:
            with open(path) as f:
                v = f.read().strip()
            if v:
                return v
        except OSError:
            continue
    return "unknown"


if __name__ == "__main__":
    sys.exit(sutra_update.main(
        pill="byebyte", slug="asuramaya/ByeByte",
        installed_version=installed_version(),
        anchor_candidates=ANCHOR_CANDIDATES,
        auto_enabled=False))
