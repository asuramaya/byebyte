#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 asuramaya and byebyte contributors
"""byebyte-healthcheck — are the daemon's vitals good?

Thin wrapper over sutra.check_health (UNIFY Wave A #3): status.json fresh
against the daemon's own declared poll_interval, control.sock answering
ping. Exit 0 when healthy, nonzero with a one-line reason when not.

Also verifies the sutra copy actually running here against its own
installed anchor (BOOTSTRAP.md) -- `make check-sutra` only ever proves the
dev-tree copy is honest; the machine runs whatever got installed, and an
anchorless install dir is exactly how a mixed-version sutra sat undetected
on a real machine before this check existed (ruling 3e44bd95). Three
states, not two: a missing anchor means an install that predates this
check, not a tampered one -- it can't be verified, which is different
from having been checked and found wrong.

Passive by design: it diagnoses and reports, it never restarts anything —
systemd's Restart= owns recovery, and a monitoring probe that mutates what
it measures can't be trusted. Honors BYEBYTE_RUNTIME_DIR exactly like
byebyted and byebyte do.
"""

import hashlib
import os
import sys

# --- sutra bootstrap (sutra 0.12.9; see docs/BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "byebyte"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra

RUNTIME_DIR = os.environ.get("BYEBYTE_RUNTIME_DIR", "/run/byebyte")
STATUS_PATH = os.path.join(RUNTIME_DIR, "status.json")
SOCKET_PATH = os.path.join(RUNTIME_DIR, "control.sock")


def check_vendor_integrity():
    """True/False for whether the installed sutra.py's own sha256 matches
    the .version anchor beside it -- the installed copy, never the dev
    tree. None when the anchor is missing: an install from before this
    check shipped, not evidence of tampering, and not something a hash
    comparison can answer either way."""
    path = os.path.abspath(sutra.__file__)
    vpath = os.path.splitext(path)[0] + ".version"
    try:
        with open(vpath) as f:
            recorded = f.read().split()[-1]
    except (OSError, IndexError):
        return None, f"no integrity anchor for {path} (older install, can't verify)"
    with open(path, "rb") as f:
        actual = hashlib.sha256(f.read()).hexdigest()
    if actual != recorded:
        return False, f"{path} does not match {vpath} — hand-edited or a stale copy"
    return True, "ok"


def main():
    vendor_ok, vendor_reason = check_vendor_integrity()
    if vendor_ok is False:
        print(f"byebyte-healthcheck: UNHEALTHY — {vendor_reason}")
        return 1
    healthy, reason, info = sutra.check_health(STATUS_PATH, SOCKET_PATH)
    if not healthy:
        print(f"byebyte-healthcheck: UNHEALTHY — {reason}")
        return 1
    vendor_note = "sutra anchor unknown" if vendor_ok is None else "sutra vendor ok"
    print(f"byebyte-healthcheck: ok (status {info['age']:.0f}s old, "
          f"byebyted {info['version']} answering, {vendor_note})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
