# Keep CI/dev-only files out of the release tarball (git archive). Scoped to
# the actual CI subpath rather than all of /.github: the community files
# (CODE_OF_CONDUCT.md/CONTRIBUTING.md/SECURITY.md) live in .github/ too, and
# those are real content the README's Map links to, not CI plumbing. A
# blanket .github export-ignore would silently drop them from every release
# tarball -- git's export-ignore, like .gitignore, never walks into an
# excluded directory even for a later more-specific un-ignore rule, so
# scoping the exclusion is the only fix, not an override.
.github/workflows export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
tests             export-ignore
Makefile          export-ignore
