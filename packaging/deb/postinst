#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# byebyte postinst — shares the config-seed logic with install.sh via
# /usr/share/byebyte/scripts/seed-owner-uid.py (packaged from
# packaging/scripts/ in the source tree) so the two installers can't drift
# apart.
set -e

CONFIG=/etc/byebyte/config.json
SEED=/usr/share/byebyte/scripts/seed-owner-uid.py

case "$1" in
  configure)
    OLD_VERSION="$2"
    if [ -z "$OLD_VERSION" ]; then
      # Fresh install only: dpkg just unpacked the package's default
      # config.json as a conffile. An upgrade means dpkg already decided
      # whether the user's edited copy survives — never re-stamp then.
      OWNER_UID="${SUDO_UID:-1000}"
      python3 "$SEED" "$CONFIG" "$CONFIG" "$OWNER_UID"
    fi
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable byebyted.service >/dev/null 2>&1 || true
    if systemctl is-active --quiet byebyted.service 2>/dev/null; then
      systemctl restart byebyted.service || true
    else
      systemctl start byebyted.service || true
    fi
    # notify.timer is the one timer enabled BY DEFAULT here, unlike
    # sweep/update: it never deletes anything and never phones out, only
    # reads and — gated by notify_categories' own conservative default set,
    # crossing-once — shows at most a desktop toast for something already
    # true. An opt-in notification feature would just reproduce the exact
    # "byebyte feels useless" problem it exists to fix (ruling, msg
    # 6489/6501). Silenceable per-category in config.json, or:
    #   sudo systemctl disable --now byebyte-notify.timer
    systemctl enable --now byebyte-notify.timer >/dev/null 2>&1 || true
    # accounting.timer: the other default-enabled timer, for the same class
    # of reason -- report-only (Trash/cold-cache/large-and-old, condemned by
    # the operator or claiming no confidence), no --yes, no act path,
    # nothing here to gate behind a second opt-in. Weekly (the fire-marshal
    # ruling, d602032b: an inspection walks the building on a schedule);
    # its own summary toast fires at most once per run, only when the
    # headline changed since the prior write, so it can't become the same
    # alert fatigue notify.timer is designed to avoid.
    #   sudo systemctl disable --now byebyte-accounting.timer
    systemctl enable --now byebyte-accounting.timer >/dev/null 2>&1 || true
    # policy.timer: Storage Sense (operator ruling 2026-09-05) -- ON by
    # default for the same reason accounting/notify are: an opt-in janitor
    # reproduces "byebyte feels useless." Safety lives in policy.json's own
    # dry_run: true default (ships that way, seeded once below), not in
    # this timer being off -- the first run only previews and writes a
    # receipt. Also runs the instant a mount crosses into "hot", entirely
    # inside byebyted, independent of this timer's own weekly cadence.
    #   sudo systemctl disable --now byebyte-policy.timer
    systemctl enable --now byebyte-policy.timer >/dev/null 2>&1 || true
    # The GNOME pill stages here (/usr/share/byebyte/extension/) but GNOME
    # Shell only ever scans /usr/share/gnome-shell/extensions/ (system-wide)
    # or ~/.local/share/gnome-shell/extensions/ (per-account) — this path is
    # neither, deliberately: install.sh's own bootstrap path prints this
    # same reminder, but that's the curl-pipe-bash install only. A plain
    # `dpkg -i`/`apt install ./byebyte.deb` never sees it otherwise, and the
    # pill would silently never appear for anyone who installed that way
    # (found by Till auditing ramstein's own packaging, flagged not fixed).
    echo
    echo ">>> the GNOME pill is a separate, per-account, NO-ROOT step — as yourself: <<<"
    echo "  mkdir -p ~/.local/share/gnome-shell/extensions"
    echo "  cp -r /usr/share/byebyte/extension/byebyte@asuramaya ~/.local/share/gnome-shell/extensions/"
    echo "  gnome-extensions enable byebyte@asuramaya"
    echo "  (then log out and back in once — Wayland reloads extensions at login)"
    ;;
esac

exit 0
